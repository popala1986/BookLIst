# Copy to .env on the server and fill in. Never commit .env.

# Docker network shared with the existing Caddy and Postgres containers
DOCKER_NETWORK=home-app_default

# PostgreSQL (existing "postgres" container, separate database and user for BookList)
DB_URL=jdbc:postgresql://postgres:5432/booklist
DB_USERNAME=booklist
DB_PASSWORD=change-me

# The single administrator account, created on first start with this password.
# After the first start you can remove APP_ADMIN_PASSWORD from this file.
APP_ADMIN_USERNAME=pawel
APP_ADMIN_PASSWORD=change-me-to-a-long-password

# Accounts: set to false after creating your own account to stop strangers from registering
APP_REGISTRATION_ENABLED=true

# Secret for "remember me" cookies. Generate with: openssl rand -hex 32
APP_REMEMBER_ME_KEY=

# Google Books API key for automatic covers (see DEPLOY.md). Without it Google often refuses requests.
GOOGLE_BOOKS_API_KEY=
